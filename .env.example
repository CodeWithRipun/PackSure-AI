APP_NAME=PackSure AI
DATABASE_URL=sqlite:///./packsure.db
MAX_UPLOAD_MB=10
# Leave empty when Tesseract is on PATH (the normal Linux/Docker setup).
# Set an absolute path only when it is installed in a non-standard location.
TESSERACT_CMD=
# Comma-separated allowed browser origins. Same-origin frontend needs no entry.
CORS_ORIGINS=
